# WeChat must use an absolute URL. Default: the deployed HTTPS API.
# Production requires a HTTPS domain configured in WeChat's request allowlist.
VITE_API_BASE_URL=https://www.shangkun.uk/gensticker/api
VITE_PROXY_TARGET=http://127.0.0.1:3001

# Optional H5 development proxy (does not change the WeChat build).
# VITE_API_BASE_URL=/api
# VITE_PROXY_TARGET=https://www.shangkun.uk/gensticker/api
# VITE_PROXY_URL=http://127.0.0.1:6789
