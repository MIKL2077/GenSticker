[Unit]
Description=GenSticker meme API
After=network.target

[Service]
Slice=gensticker.slice
User=gensticker
Group=gensticker
WorkingDirectory=/opt/gensticker-current/meme-generator
Environment=HOME=/var/lib/gensticker
Environment=XDG_CONFIG_HOME=/var/lib/gensticker/.config
Environment=XDG_CACHE_HOME=/var/cache/gensticker
Environment=FONTCONFIG_FILE=/etc/fonts/fonts.conf
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GENSTICKER_STATE_DIR=/var/lib/gensticker
Environment=U2NET_HOME=/var/cache/gensticker/models
Environment=WX_APPID=wx2e3a058ed0117034
EnvironmentFile=-/etc/gensticker.env
ExecStart=/opt/gensticker-current/api-venv/bin/python -m uvicorn meme_generator.app:app --host 127.0.0.1 --port 3001 --workers 1 --limit-concurrency 24
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gensticker /var/cache/gensticker
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=2G
CPUQuota=200%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
