# Install privately as /etc/gensticker-minimax.env, root:root 0600.
# Supply the Mainland Coding/Token Plan subscription key outside Git.
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimax.cn
GENSTICKER_MINIMAX_MODEL=MiniMax-M3
GENSTICKER_MODEL_JSON_MODE=text
# Fresh hosts stay disabled until real-render acceptance passes. The existing
# production host enabled qualified publication on 2026-10-26; see the rollout
# report. Set to 1 privately after validating a new host; never commit its key.
GENSTICKER_MINIMAX_ENABLED=0
# Explicit operator authorization is needed for attributed/unverified sources.
GENSTICKER_ALLOW_ATTRIBUTED_SOURCES=0
GENSTICKER_INGEST_TARGET=5
GENSTICKER_INGEST_ATTEMPTS=18
GENSTICKER_MODEL_DAILY_CALLS=240
