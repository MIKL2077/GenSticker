# Install privately as /etc/gensticker-archive.env, root:root 0600.
GENSTICKER_ARCHIVE_REMOTE=git@github.com:MIKL2077/GenSticker.git
GENSTICKER_ARCHIVE_BRANCH=template-archive
GENSTICKER_ARCHIVE_SSH_KEY=/var/lib/gensticker/.ssh/template_archive_ed25519
GENSTICKER_ARCHIVE_KNOWN_HOSTS=/var/lib/gensticker/.ssh/archive_known_hosts
GENSTICKER_ARCHIVE_MAX_BYTES=3221225472
