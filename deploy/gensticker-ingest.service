[Unit]
Description=GenSticker bounded public-source skill authoring
After=network.target

[Service]
Slice=gensticker.slice
User=gensticker
Group=gensticker
WorkingDirectory=/opt/gensticker-current/meme-generator
Environment=HOME=/var/lib/gensticker
Environment=XDG_CONFIG_HOME=/var/lib/gensticker/.config
Environment=XDG_CACHE_HOME=/var/cache/gensticker
Environment=FONTCONFIG_FILE=/etc/fonts/fonts.conf
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GENSTICKER_STATE_DIR=/var/lib/gensticker
Environment=WX_APPID=wx2e3a058ed0117034
EnvironmentFile=-/etc/gensticker.env
EnvironmentFile=/etc/gensticker-minimax.env
EnvironmentFile=/etc/gensticker-human-review.env
Environment=U2NET_HOME=/var/cache/gensticker/models
Environment=OPENBLAS_NUM_THREADS=2
Environment=OMP_NUM_THREADS=2
Type=oneshot
ExecStart=/opt/gensticker-current/worker-venv/bin/python -m meme_generator.features.scheduled_authoring
TimeoutStartSec=45m
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gensticker /var/cache/gensticker
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=2G
CPUQuota=50%
Nice=15
IOSchedulingClass=idle
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
